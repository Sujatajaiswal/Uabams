# PostgreSQL connection string used by the backend
# Local docker-compose default:
DATABASE_URL=postgresql+psycopg2://uabams:uabams@db:5432/uabams

# CORS - comma separated list of allowed origins, "*" for demo
CORS_ORIGINS=*

# Default sampling rate sent to gateways via /api/v1/config (Hz)
DEFAULT_SAMPLING_RATE=2500

# Gateway considered OFFLINE if no upload received within this many seconds
GATEWAY_OFFLINE_AFTER_SECONDS=300

# Seed the database with demo data on startup (true/false)
SEED_ON_STARTUP=true

# Optional MongoDB Atlas mirror for raw gateway/cloud storage demo
MONGODB_URL=
MONGODB_DB_NAME=uabams_cloud

# API key authentication for protected /api/v1 endpoints
AUTH_API_KEY=uabams-demo-api-key

# SMS demo/provider settings
SMS_ENABLED=false
SMS_PROVIDER_URL=
SMS_API_KEY=
SMS_FROM=UABAMS
SMS_TO_NUMBERS=

